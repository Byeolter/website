// Byeolter Privacy Policy Page
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="유행음식 연구소 개인정보 처리방침">
<title>유행음식 연구소 개인정보 처리방침 | Byeolter</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/galmuri/dist/galmuri.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" rel="stylesheet">
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"77e8c60824024ca6a24335815f869f18"}'></script>
<style>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  img{image-rendering:pixelated}
  ::selection{background:#ffd23f;color:#0a0a1f}
  @keyframes twpix{0%,100%{opacity:.35}50%{opacity:1}}
  @media (max-width:760px){
    [data-nav-desktop]{display:none !important}
    [data-nav-burger]{display:flex !important}
  }
</style>
</head>
<body>
<div style="position:relative;min-height:100vh;background:radial-gradient(120% 70% at 50% -10%, #1a1140 0%, rgba(26,17,64,0) 55%), #0a0a1f;color:#eaf0ff;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif">

  <div id="sky" style="position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:1"></div>

  <div style="position:relative;z-index:5">

    <!-- NAV -->
    <nav style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px clamp(16px,4vw,40px);border-bottom:3px solid #000;background:#0d0d28;box-shadow:0 3px 0 #ffd23f">
      <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:#eaf0ff">
        <img src="/assets/star.png" alt="Byeolter star" width="26" height="26" style="display:block">
        <span style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:13px;color:#ffd23f;letter-spacing:1px">BYEOLTER</span>
      </a>
      <div style="display:flex;align-items:center;gap:26px" data-nav-desktop="">
        <a href="/apps/" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#4fe0d8;text-decoration:none">APPS</a>
        <a href="/games/" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#ff5db1;text-decoration:none">GAMES</a>
        <a href="/#contact" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#9bf24a;text-decoration:none">CONTACT</a>
      </div>
      <button id="btn-menu" aria-label="Menu" style="display:none;background:#ff5db1;border:3px solid #000;width:42px;height:38px;cursor:pointer;box-shadow:3px 3px 0 #000;align-items:center;justify-content:center;flex-direction:column;gap:4px" data-nav-burger="">
        <span style="width:18px;height:3px;background:#0a0a1f;display:block"></span>
        <span style="width:18px;height:3px;background:#0a0a1f;display:block"></span>
        <span style="width:18px;height:3px;background:#0a0a1f;display:block"></span>
      </button>
    </nav>
    <div id="mobile-menu" style="position:sticky;top:71px;z-index:39;display:none;flex-direction:column;background:#0d0d28;border-bottom:3px solid #000;box-shadow:0 10px 0 rgba(0,0,0,.35)">
      <a href="/apps/" onclick="document.getElementById('mobile-menu').style.display='none'" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#4fe0d8;text-decoration:none;padding:16px 24px;border-bottom:2px solid #1d1d44">APPS</a>
      <a href="/games/" onclick="document.getElementById('mobile-menu').style.display='none'" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#ff5db1;text-decoration:none;padding:16px 24px;border-bottom:2px solid #1d1d44">GAMES</a>
      <a href="/#contact" onclick="document.getElementById('mobile-menu').style.display='none'" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#9bf24a;text-decoration:none;padding:16px 24px">CONTACT</a>
    </div>

    <main style="max-width:800px;margin:0 auto;padding:clamp(40px,7vw,76px) clamp(16px,4vw,28px) clamp(48px,8vw,90px)">

      <header style="text-align:center;margin-bottom:clamp(34px,6vw,52px)">
        <img src="/assets/star.png" alt="" width="56" height="56" style="display:block;margin:0 auto 22px;filter:drop-shadow(0 0 14px rgba(255,210,63,.45))">
        <h1 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(20px,5vw,38px);line-height:1.3;margin:0;color:#ffd23f;text-shadow:4px 4px 0 #ff5db1">PRIVACY POLICY</h1>
        <p style="font-size:clamp(16px,2.4vw,19px);line-height:1.7;color:#cdd6ff;margin:20px auto 0">유행음식 연구소 (Trend Food Lab) 개인정보 처리방침</p>
        <p style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#9bf24a;margin:22px 0 0">LAST UPDATED NOVEMBER 3, 2026</p>
      </header>
      <div style="display:flex;flex-direction:column;gap:clamp(22px,3.5vw,30px)">
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">개요</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0">「유행음식 연구소」(이하 "앱")는 BYEOLTER가 만든 미니게임입니다. 이 문서는 앱이 어떤 정보를 처리하는지, 왜 처리하는지, 이용자가 할 수 있는 선택은 무엇인지 설명합니다. 회원가입과 로그인은 없으며, 이름·연락처·위치·사진 등은 수집하지 않습니다.</p></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">수집하는 정보</h2><ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px"><li style="display:flex;gap:12px;font-size:clamp(15px,2.2vw,18px);line-height:1.7;color:#cdd6ff"><span style="color:#4fe0d8;flex-shrink:0">&#9656;</span><span><strong style="color:#eaf0ff">연구원 이름(닉네임).</strong> 이용자가 직접 입력하거나 앱이 무작위로 추천한 이름입니다. 랭킹에 표시됩니다. 실명이나 개인정보는 입력하지 말아 주세요.</span></li><li style="display:flex;gap:12px;font-size:clamp(15px,2.2vw,18px);line-height:1.7;color:#cdd6ff"><span style="color:#4fe0d8;flex-shrink:0">&#9656;</span><span><strong style="color:#eaf0ff">임의 생성 식별자.</strong> 앱을 처음 실행하면 기기 안에서 무작위 문자열(플레이어 키)이 만들어집니다. 같은 사람의 점수와 투표를 구분하는 용도이며, 광고 ID나 기기 고유번호와는 무관합니다.</span></li><li style="display:flex;gap:12px;font-size:clamp(15px,2.2vw,18px);line-height:1.7;color:#cdd6ff"><span style="color:#4fe0d8;flex-shrink:0">&#9656;</span><span><strong style="color:#eaf0ff">게임 기록.</strong> 점수와 랭킹 정보가 서버에 저장됩니다.</span></li><li style="display:flex;gap:12px;font-size:clamp(15px,2.2vw,18px);line-height:1.7;color:#cdd6ff"><span style="color:#4fe0d8;flex-shrink:0">&#9656;</span><span><strong style="color:#eaf0ff">요청 내용.</strong> 이용자가 "만들어 주세요" 요청 화면에 입력한 음식 이름과 투표 내역이 서버에 저장됩니다.</span></li><li style="display:flex;gap:12px;font-size:clamp(15px,2.2vw,18px);line-height:1.7;color:#cdd6ff"><span style="color:#4fe0d8;flex-shrink:0">&#9656;</span><span><strong style="color:#eaf0ff">기기 내 설정.</strong> 사운드 설정, 진행 상황, 닉네임 변경 기록은 기기에만 저장되며 서버로 보내지 않습니다.</span></li></ul></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">이용 목적</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0">랭킹 표시, 요청 접수·검토, 투표 집계, 서비스 개선과 부정 이용 방지에만 사용합니다. 광고 목적으로 사용하지 않으며, 판매하거나 제3자에게 제공하지 않습니다. 부적절한 닉네임이나 요청은 검토 후 노출하지 않을 수 있습니다.</p></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">광고 · 분석 · 외부 서비스</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0">앱에는 광고 SDK와 사용자 분석 SDK가 없습니다. 데이터 저장에는 Supabase(클라우드 데이터베이스)를 사용하며, 이 서버로 위에 적은 정보가 암호화된 연결(HTTPS)로 전송됩니다. 앱 글꼴과 게임 엔진은 앱 안에 포함되어 있어 실행 중 외부 사이트에서 내려받지 않습니다.</p></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">보관과 삭제</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0">랭킹·요청 데이터는 서비스 운영 기간 동안 보관합니다. 앱을 삭제하면 기기에 저장된 플레이어 키와 설정이 함께 지워지며, 서버에 남은 점수·요청·닉네임의 삭제를 원하시면 아래 연락처로 알려 주세요. 확인 가능한 범위에서 삭제해 드립니다.</p></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">아동</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0">앱은 전 연령이 이용할 수 있는 간단한 게임이며, 연령 확인 목적의 정보를 수집하지 않습니다. 이용자가 입력하는 닉네임과 요청 문구 외에 개인을 식별할 수 있는 정보는 받지 않습니다.</p></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">정책 변경</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0">내용이 바뀌면 이 페이지의 최종 수정일을 갱신해 알려 드립니다.</p></section>
<section style="background:#0e1030;border:3px solid #000;box-shadow:0 0 0 3px #1d1d44, 0 14px 34px rgba(0,0,0,.4);padding:clamp(22px,4vw,34px)"><h2 style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(13px,2.6vw,17px);line-height:1.5;color:#ffd23f;margin:0 0 18px">문의</h2><p style="font-size:clamp(15px,2.2vw,18px);line-height:1.8;color:#cdd6ff;margin:0;margin-bottom:16px">개인정보 관련 문의와 삭제 요청은 아래 이메일로 보내 주세요.</p><a href="mailto:contact@byeolter.com" style="color:#4fe0d8;text-decoration:underline;text-underline-offset:3px">contact@byeolter.com</a></section>
      </div>
    </main>

    <!-- FOOTER -->
    <footer style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;padding:18px clamp(16px,4vw,40px);border-top:3px solid #000;background:#0d0d28;font-family:'Press Start 2P','Galmuri11',monospace;font-size:8px;color:#6a73b8">
      <span style="color:#ffd23f">&copy; 2026 BYEOLTER</span>
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:24px">
        <a href="/privacy/" style="color:#4fe0d8;text-decoration:none;border-bottom:2px solid #4fe0d8;padding-bottom:3px">PRIVACY</a>
        <a href="mailto:contact@byeolter.com" style="color:#ff5db1;text-decoration:none">CONTACT</a>
        <a href="https://play.google.com/store/apps/details?id=com.starterkim.widgetbuddy&hl=ko" target="_blank" rel="noopener" style="color:#9bf24a;text-decoration:none">GOOGLE PLAY</a>
      </div>
    </footer>

  </div>
</div>

<script>
// Sky stars (softer palette, lower density)
(function() {
  const sky = document.getElementById('sky');
  const cols = ['#ffffff','#aeb9ff','#ffd23f','#4fe0d8'];
  for (let i = 0; i < 46; i++) {
    const d = document.createElement('div');
    const size = Math.random() < 0.75 ? 2 : 3;
    const dur = (3 + Math.random() * 4).toFixed(2);
    const delay = (Math.random() * 5).toFixed(2);
    const baseOp = (0.4 + Math.random() * 0.4).toFixed(2);
    d.style.cssText = `position:absolute;left:${(Math.random()*100).toFixed(2)}%;top:${(Math.random()*100).toFixed(2)}%;width:${size}px;height:${size}px;background:${cols[(Math.random()*cols.length)|0]};image-rendering:pixelated;opacity:${baseOp};animation:twpix ${dur}s ease-in-out ${delay}s infinite`;
    sky.appendChild(d);
  }
})();

// Mobile nav
document.getElementById('btn-menu').addEventListener('click', () => {
  const m = document.getElementById('mobile-menu');
  m.style.display = m.style.display === 'flex' ? 'none' : 'flex';
});
</script>
</body>
</html>

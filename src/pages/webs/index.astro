        <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:#eaf0ff"><img src="/assets/star.png" alt="Byeolter star" width="26" height="26" style="display:block;image-rendering:pixelated"><span style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:13px;color:#ffd23f;letter-spacing:1px">BYEOLTER</span></a>
        <div style="display:flex;align-items:center;gap:14px" data-nav-desktop=""><a href="/apps/" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#4fe0d8;text-decoration:none;padding:9px 11px">APPS</a><a href="/games/" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#ff5db1;text-decoration:none;padding:9px 11px">GAMES</a><span style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#0a0a1f;background:#b88cff;padding:9px 11px;border:2px solid #000;box-shadow:3px 3px 0 #000">WEBS</span><a href="/#contact" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:9px;color:#9bf24a;text-decoration:none;padding:9px 11px">CONTACT</a></div>
        <button id="btn-menu" aria-label="Menu" style="display:none;background:#b88cff;border:3px solid #000;width:42px;height:38px;cursor:pointer;box-shadow:3px 3px 0 #000;align-items:center;justify-content:center;flex-direction:column;gap:4px" data-nav-burger=""><span style="width:18px;height:3px;background:#0a0a1f;display:block"></span><span style="width:18px;height:3px;background:#0a0a1f;display:block"></span><span style="width:18px;height:3px;background:#0a0a1f;display:block"></span></button>
      </nav>
      <div id="mobile-menu" style="display:none;flex-direction:column;background:#0d0d28;border-bottom:3px solid #000"><a href="/apps/" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#4fe0d8;text-decoration:none;padding:16px 24px;border-bottom:2px solid #1d1d44">APPS</a><a href="/games/" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#ff5db1;text-decoration:none;padding:16px 24px;border-bottom:2px solid #1d1d44">GAMES</a><span style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#0a0a1f;background:#b88cff;padding:16px 24px;border-bottom:2px solid #1d1d44">WEBS</span><a href="/#contact" style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#9bf24a;text-decoration:none;padding:16px 24px">CONTACT</a></div>
    </div>
    <div style="overflow:hidden;background:#b88cff;border-top:3px solid #000;border-bottom:3px solid #000;padding:9px 0"><div style="white-space:nowrap;font-family:'Press Start 2P','Galmuri11',monospace;font-size:10px;color:#0a0a1f;text-align:center">★ WEB WORLDS ★ TINY PLACES TO VISIT ★ MADE IN SEOUL ★</div></div>

<meta name="description" content="Byeolter Webs — tiny places to visit on the internet.">
<title>Webs | Byeolter</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/galmuri/dist/galmuri.css" rel="stylesheet">
<style>
  *{box-sizing:border-box} html,body{margin:0;padding:0} ::selection{background:#ff5db1;color:#0a0a1f}
  @keyframes twpix{0%,100%{opacity:.2}50%{opacity:1}} @keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
  @keyframes riseIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  @media (max-width:760px){[data-nav-desktop]{display:none!important}[data-nav-burger]{display:flex!important}}
</style>
</head>
<body>
<div style="position:relative;min-height:100vh;background:radial-gradient(120% 80% at 50% -10%,#241344 0%,rgba(36,19,68,0) 55%),#0a0a1f;color:#eaf0ff;font-family:'VT323','Galmuri11',monospace">
  <div id="sky" style="position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:1"></div>

    <main style="padding:0 clamp(16px,4vw,40px) clamp(56px,8vw,100px)">
      <div style="max-width:1080px;margin:0 auto">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:40px">
          <span style="font-family:'Press Start 2P','Galmuri11',monospace;font-size:clamp(12px,2.4vw,16px);color:#eaf0ff;letter-spacing:1px">WEB DIRECTORY</span>
